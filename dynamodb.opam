# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "DynamoDB JSON 1.0 protocol: requests, responses, errors"
description: """
Request encoding, response decoding and error parsing for PutItem, GetItem,
DeleteItem, UpdateItem, Query, Scan and TransactWriteItems. Items carry every
DynamoDB attribute type; numbers are exact decimals. HTTP goes through the
effect Dynamodb.Effects.Call; see dynamodb-cohttp-eio for a handler."""
maintainer: ["Yuki Tajiri"]
authors: ["Yuki Tajiri"]
license: "MIT"
homepage: "https://github.com/lmdexpr/dynamodb.ml"
bug-reports: "https://github.com/lmdexpr/dynamodb.ml/issues"
depends: [
  "ocaml" {>= "5.3.0"}
  "dune" {>= "3.23"}
  "yojson"
  "base64"
  "ppx_yojson_conv"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lmdexpr/dynamodb.ml.git"
x-maintenance-intent: ["(latest)"]
