# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Cohttp-eio handler for dynamodb: endpoint, SigV4 signing, HTTP"
description: """
Handles Dynamodb.Effects.Call with a cohttp-eio client, signing requests with
sigv4 and resolving credentials with sigv4-cohttp-eio."""
maintainer: ["Yuki Tajiri"]
authors: ["Yuki Tajiri"]
license: "MIT"
homepage: "https://github.com/lmdexpr/dynamodb.ml"
bug-reports: "https://github.com/lmdexpr/dynamodb.ml/issues"
depends: [
  "ocaml" {>= "5.3.0"}
  "dune" {>= "3.23"}
  "dynamodb" {= version}
  "sigv4"
  "sigv4-cohttp-eio"
  "eio"
  "cohttp-eio"
  "uri"
  "http"
  "yojson"
  "eio_main" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lmdexpr/dynamodb.ml.git"
x-maintenance-intent: ["(latest)"]
# sigv4 is not on the opam repository yet.
pin-depends: [
  ["sigv4.dev" "git+https://github.com/lmdexpr/sigv4.ml.git#9a2e7247de94b9023e41f0217e8b9bc7eb14b926"]
  ["sigv4-cohttp-eio.dev" "git+https://github.com/lmdexpr/sigv4.ml.git#9a2e7247de94b9023e41f0217e8b9bc7eb14b926"]
]
